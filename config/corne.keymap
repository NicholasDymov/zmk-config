#define ZMK_POINTING_DEFAULT_SCRL_VAL 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <175>;
};

&msc {
	acceleration-exponent = <1>;
	time-to-max-speed-ms = <300>;
	delay-ms = <0>;
};

/ {
        chosen {                                
            zmk,matrix_transform = &five_column_transform;                       
        };                                      
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
&kp Q	&kp W		&kp E		&kp R		&kp T		&kp Y		&kp U		&kp I		&kp O		&kp P   
&kp A	&mt LALT S	&mt LCTRL D	&mt LSHFT F	&kp G		&kp H		&mt RSHFT J	&mt RCTRL K	&mt RALT L	&kp SEMI
&kp Z	&kp X		&kp C		&kp V		&kp B		&kp N		&kp M		&kp COMMA	&kp DOT		&kp FSLH
		&sk LGUI	&lt 1 BSPC	&lt 2 ESC				&lt 2 RET	&lt 1 SPACE	&mt RGUI TAB
                        >;
                };
                lower_layer {
                        bindings = <
&kp GRAVE	&kp HASH	   &kp LPAR		  &kp RPAR       &kp BSLH		&kp LT	 &kp GT			 &kp ASTRK		 &kp TILDE	   &kp CARET
&kp EXCL	&mt LALT UNDER &mt LCTRL LBKT &mt LSHFT RBKT &kp DLLR		&kp PLUS &mt RSHFT EQUAL &mt RCTRL MINUS &mt RALT PRCNT &kp DQT
&kp PIPE	&kp AMPS	   &kp LBRC		  &kp RBRC		 &kp AT			&kp GT	 &kp N1			 &kp N2			 &kp N3		   &kp QMARK
						   &kp COLON	  &kp BSPC		 &kp ESC		&kp RET	 &kp MINUS		 &kp N0
                        >;
                };
                raise_layer {
                        bindings = <
&to 3	&sl 3		&none	&kp PG_UP	&kp C_BRI_UP		&msc SCRL_UP		&kp N7	&kp N8	&kp N9	&kp K_VOL_UP
&none	&kp LEFT	&kp UP	&kp DOWN	&kp RIGHT			&none				&kp N4	&kp N5	&kp N6	&kp APOS
&none	&none		&none	&kp PG_DN	&kp C_BRI_DN		&msc SCRL_DOWN		&kp N1	&kp N2	&kp N3	&kp K_VOL_DN
					&none	&none		&none				&kp DOWN			&kp UP	&kp N0
                        >;
                };
                extra_layer {
                        bindings = <
&none		&none			&sys_reset		&bootloader		&none			&none	&kp F7	&kp F8	&kp F9	&kp F12
&bt BT_CLR	&bt BT_SEL 0	&bt BT_SEL 1	&bt BT_SEL 2	&none			&none	&kp F4	&kp F5	&kp F6	&kp F11
&none		&none			&none			&none			&none			&none	&kp F1	&kp F2	&kp F3	&kp F10
							&to 0			&to 0			&to 0			&to 0	&to 0	&to 0
                        >;
                };
        };
};
